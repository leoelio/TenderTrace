# TenderTrace local configuration template.
# Copy to .env.local for local use. Never commit .env.local.

TENDERTRACE_APP_ENV=dev
TENDERTRACE_HOST=127.0.0.1
TENDERTRACE_PORT=8000
TENDERTRACE_TIMEZONE=Asia/Shanghai

# Delivery channels: Web download + local outbox by default.
# Add email / feishu_bitable only after the corresponding settings are configured.
TENDERTRACE_DELIVERY_CHANNELS=web,outbox

# Optional SMTP email delivery. Keep passwords only in .env.local or OS env.
TENDERTRACE_SMTP_HOST=
TENDERTRACE_SMTP_PORT=587
TENDERTRACE_SMTP_USERNAME=
TENDERTRACE_SMTP_PASSWORD=
TENDERTRACE_SMTP_FROM=
TENDERTRACE_SMTP_TO=
TENDERTRACE_SMTP_USE_TLS=true
TENDERTRACE_SMTP_TIMEOUT=15

# Optional Feishu Bitable opportunity ledger. Keep App Secret only in .env.local.
TENDERTRACE_FEISHU_APP_ID=
TENDERTRACE_FEISHU_APP_SECRET=
TENDERTRACE_FEISHU_BITABLE_APP_TOKEN=
TENDERTRACE_FEISHU_BITABLE_TABLE_ID=
TENDERTRACE_FEISHU_TIMEOUT=20
TENDERTRACE_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional in dev; required when TENDERTRACE_APP_ENV=prod or production.
TENDERTRACE_API_TOKEN=

# Start APScheduler when serving the Web app.
TENDERTRACE_SCHEDULER_ENABLED=true

# Optional background ingest pool: collect into SQLite first, then serve user queries from local FTS.
TENDERTRACE_INGEST_ENABLED=false
TENDERTRACE_INGEST_CRON=0 */6 * * *
TENDERTRACE_INGEST_TOPICS=服务器,充电桩,空调,储能,医疗设备,电梯,消防,安防,网络设备
TENDERTRACE_INGEST_REGIONS=北京,上海,广东,江苏,浙江,安徽,四川,河南

# Optional hybrid retrieval. Install with: python -m pip install -e .[vector]
TENDERTRACE_VECTOR_ENABLED=false
TENDERTRACE_VECTOR_MODEL=BAAI/bge-small-zh-v1.5
TENDERTRACE_VECTOR_TOP_K=30

# Runtime paths. Relative paths are resolved from the workspace root.
TENDERTRACE_DB_PATH=data/tendertrace.sqlite3
TENDERTRACE_OUTPUTS_DIR=outputs
TENDERTRACE_OUTBOX_DIR=outbox
TENDERTRACE_SNAPSHOTS_DIR=snapshots
TENDERTRACE_TRACES_DIR=traces
TENDERTRACE_SECRETS_DIR=secrets

# Attachment snapshot safety limits.
TENDERTRACE_ATTACHMENT_MAX_PER_NOTICE=3
TENDERTRACE_ATTACHMENT_MAX_BYTES=8388608

# Model mode: disabled | local | cloud
# local = Ollama, cloud = OpenAI-compatible API.
# Check configuration with: python -m tendertrace model-doctor
TENDERTRACE_MODEL_MODE=local
TENDERTRACE_MODEL_ENHANCEMENT_ENABLED=false
TENDERTRACE_MODEL_REQUEST_TIMEOUT=8

# Recommended local model for Chinese bidding-document intent work.
# Verify availability with: ollama run qwen3:8b
TENDERTRACE_OLLAMA_BASE_URL=http://127.0.0.1:11434
TENDERTRACE_OLLAMA_MODEL=qwen3:8b

# Cloud enhancement mode. Keep the key only in .env.local or OS env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
TENDERTRACE_OPENAI_API_STYLE=responses
